# Installed and built output is recreated inside the image.
**/node_modules
**/dist
**/.next
**/.expo
**/.expo-export
**/*.tsbuildinfo
coverage

# Never send secrets or local config into the build context.
.env
**/.env
**/.env.*
!.env.example

# The mobile app ships through EAS, not Docker.
apps/mobile/android
apps/mobile/ios
apps/mobile/assets

.git
*.log
