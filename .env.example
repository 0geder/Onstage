# ─────────────────────────────────────────────────────────────
# Onstage — environment template.
# Copy to .env and fill in. Never commit the filled-in version.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Datastores ───────────────────────────────────────────────
DATABASE_URL=postgresql://onstage:onstage@localhost:5432/onstage?schema=public
REDIS_URL=redis://localhost:6379

# ── API ──────────────────────────────────────────────────────
API_PORT=3000
API_BASE_URL=http://localhost:3000
# Required in production (startup fails without it; '*' is rejected). Unset
# in development allows any localhost origin.
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
# Number of reverse-proxy hops in front of the API (e.g. 1 behind a single load
# balancer), so rate limits key on the real client IP. Unset trusts none.
TRUST_PROXY=
# Swagger UI at /docs is always on outside production; set true to serve it there.
ENABLE_API_DOCS=false

# ── Auth (Firebase Auth) ─────────────────────────────────────
# AUTH_MODE=dev accepts "Bearer dev:<userId>" tokens without a Firebase project,
# and only starts when NODE_ENV is development or test. Anything else, including
# unset, means firebase.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n escapes, wrapped in quotes.
FIREBASE_PRIVATE_KEY=

# ── Admin CMS ────────────────────────────────────────────────
ADMIN_PORT=3001
# Static bearer token guarding /admin endpoints. Generate: openssl rand -hex 32
ADMIN_API_TOKEN=change-me-in-every-environment
# CMS operator sign-in. One JSON entry per person, generated with:
#   npm run hash-password -w @onstage/admin -- you@onstage.co.za [api-user-uuid]
# userId (optional) is that person's isAdmin user in the API, so moderation is
# recorded against them. Example: ADMIN_USERS=[{"email":"...","passwordHash":"scrypt$..."}]
ADMIN_USERS=
# Signs CMS session cookies. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Ingestion providers ──────────────────────────────────────
# Verify current commercial terms for each before enabling in production.
INGESTION_ENABLED=true
INGESTION_HOT_CRON=0 * * * *
INGESTION_COLD_CRON=0 4 * * *
# Worker: cron patterns are read in this zone. Run exactly one worker, or rely
# on the per-job Postgres advisory locks if you run more.
WORKER_TIMEZONE=Africa/Johannesburg
# Longest a job may run (and hold its lock) before it is rolled back.
JOB_MAX_RUNTIME_MS=7200000
# Account deletion (POPIA): requests are carried out after this many days.
# Also uses FIREBASE_PROJECT_ID/CLIENT_EMAIL/PRIVATE_KEY to delete the sign-in.
DELETION_GRACE_DAYS=7
ACCOUNT_DELETION_CRON=30 3 * * *

BANDSINTOWN_APP_ID=
BANDSINTOWN_BASE_URL=https://rest.bandsintown.com

SONGKICK_API_KEY=
SONGKICK_BASE_URL=https://api.songkick.com/api/3.0

TICKETMASTER_API_KEY=
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2

QUICKET_API_KEY=
QUICKET_USER_TOKEN=
QUICKET_BASE_URL=https://api.quicket.co.za/api

# ── Streaming metadata ───────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Maps ─────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Push notifications ───────────────────────────────────────
# Delivered through the Expo push service (fronts APNs + FCM). Anything other
# than "expo" logs notifications instead of sending them.
PUSH_DELIVERY=
# Only needed once "enhanced push security" is enabled on the Expo project.
EXPO_ACCESS_TOKEN=

# ── Object storage (MinIO locally, S3 in production) ─────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=af-south-1
S3_BUCKET=onstage-media
S3_ACCESS_KEY_ID=onstage
S3_SECRET_ACCESS_KEY=onstage123
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=http://localhost:9000/onstage-media

# ── Mobile app (Expo) ────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# The venue map uses OpenFreeMap tiles through MapLibre, so it needs no key.

# Firebase client config — the public half of the pair. Safe to ship in the
# app binary; this is not the Admin SDK credential above. Get these from the
# Firebase console: Project settings → General → Your apps → (register an
# iOS/Android/Web app under the SAME project as FIREBASE_PROJECT_ID above).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Google sign-in OAuth client IDs. Firebase console → Authentication →
# Sign-in method → Google → enabling it auto-creates a Web client under
# Google Cloud Console → APIs & Services → Credentials, where you also add
# iOS/Android OAuth client IDs matching the bundleIdentifier/package in
# apps/mobile/app.json.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Apple Sign In needs no client-side key here — it authenticates natively via
# expo-apple-authentication. It does need "Sign In with Apple" enabled as a
# capability on your App ID in the Apple Developer portal, and only works in
# a custom dev client / EAS build, not in plain Expo Go.

# ── Public web (SEO pages and share cards) ───────────────────
WEB_PORT=3002
WEB_BASE_URL=http://localhost:3002
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3002
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/onstage/id000000000
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=za.co.onstage
# Restricts next/image to the media CDN host (e.g. cdn.onstage.co.za).
CDN_HOSTNAME=
# App-link verification served from /.well-known/ so the app opens onstage.co.za links.
# Android: signing-cert SHA-256 fingerprint(s), comma-separated (eas credentials / Play Console).
ANDROID_CERT_SHA256=
# iOS: 10-character Apple Developer Team ID.
APPLE_TEAM_ID=

# ── Affiliate attribution on outbound ticket links ───────────
# No payment is processed in-app; these only attribute a purchase made on the
# provider's own site. Confirm the parameter name with each programme first.
AFFILIATE_ID=
AFFILIATE_PARAMS={"quicket":"ref","webtickets":"ref","ticketmaster":"camefrom","howler":"ref"}

# ── POPIA ────────────────────────────────────────────────────
# Bump when the privacy policy changes; stored against every consent record.
PRIVACY_POLICY_VERSION=2026-01-01
