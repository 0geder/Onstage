# ─────────────────────────────────────────────────────────────────────────────
# Onstage — PRODUCTION settings for docker-compose.prod.yml.
#
# On the server:  cp .env.production.example .env.production
#                 chmod 600 .env.production
# then replace every CHANGE_ME. Never commit .env.production (it is gitignored).
#
# [REQUIRED]  the stack refuses to start without it (deploy.sh also refuses
#             while any value still reads CHANGE_ME).
# [optional]  leave empty to switch that feature off.
#
# Quoting rules (Docker Compose reads this file):
#   - Values containing $ or JSON go in 'single quotes' (taken literally).
#   - FIREBASE_PRIVATE_KEY goes in "double quotes" with \n for line breaks.
#   - Generate secrets with:  openssl rand -hex 32   (64 letters/digits: long
#     enough for the API's 32-character minimum, and safe inside the database
#     and Redis connection URLs).
#
# The API and worker refuse to start in production (and say which variable is
# wrong, never its value) if a required secret is missing, too short, or a
# development default. Check with:  docker compose ... logs api worker
#
# Variables NOT listed here are set by docker-compose.prod.yml itself:
# NODE_ENV, API_PORT, DATABASE_URL, REDIS_URL, AUTH_MODE, API_BASE_URL,
# WEB_BASE_URL and the internal API address used by web/admin.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domains & HTTPS ──────────────────────────────────────────────────────────
# [REQUIRED] Each needs a DNS A record pointing at this server (docs/DEPLOY.md).
API_DOMAIN=api.onstage.co.za
# [REQUIRED] The public website. www.<WEB_DOMAIN> redirects here (needs DNS too).
WEB_DOMAIN=onstage.co.za
# [REQUIRED] The admin CMS.
ADMIN_DOMAIN=admin.onstage.co.za
# [REQUIRED] Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL=CHANGE_ME@example.com

# ── Images ───────────────────────────────────────────────────────────────────
# [optional] Tag for locally built images; deploy.sh sets it to the git commit.
IMAGE_TAG=latest
# [optional] Registry prefix, only if you build elsewhere and pull (deploy.sh --pull).
IMAGE_REGISTRY=onstage

# ── Database (Postgres + PostGIS; never exposed to the internet) ─────────────
POSTGRES_USER=onstage
POSTGRES_DB=onstage
# [REQUIRED] openssl rand -hex 32. Must not be a dev value such as "onstage"
# or "postgres" (the API and worker refuse those). Only read when the database is first
# created; changing it later needs ALTER USER inside Postgres as well.
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis (cache + rate limits; never exposed) ───────────────────────────────
# [REQUIRED] openssl rand -hex 32 (must not be empty)
REDIS_PASSWORD=CHANGE_ME

# ── API ──────────────────────────────────────────────────────────────────────
# [optional] Browser origins allowed to call the API, comma-separated, each
# starting https:// (the API refuses anything else in production).
# Defaults to https://<WEB_DOMAIN>. The mobile app does not need an entry.
CORS_ORIGINS=
# [required by the API; defaults to 1] Proxy hops in front of the API.
# 1 = Caddy only. Leave at 1. Use 2
# only if you add Cloudflare/another proxy AND configure it in deploy/Caddyfile.
TRUST_PROXY=1
# [optional] true serves Swagger at https://<API_DOMAIN>/docs (maps admin routes).
ENABLE_API_DOCS=false
# [REQUIRED] Bearer token the admin CMS uses to call /admin endpoints.
# At least 32 characters: openssl rand -hex 32
ADMIN_API_TOKEN=CHANGE_ME

# ── Firebase Auth (Admin SDK service account) ────────────────────────────────
# [REQUIRED] Firebase console → Project settings → Service accounts →
# Generate new private key. Copy three fields from that JSON file. The API
# AND the worker need them (the worker deletes sign-ins for POPIA deletion).
# FIREBASE_PRIVATE_KEY: one line, double quotes, keep the \n sequences exactly
# as in the JSON: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_CLIENT_EMAIL=CHANGE_ME
FIREBASE_PRIVATE_KEY="CHANGE_ME"

# ── Sign in with Apple (server side) ─────────────────────────────────────────
# [optional, needed for App Store account-deletion rules if Apple sign-in is
# offered] Lets the API/worker revoke a user's Apple sign-in when they delete
# their account. Apple Developer → Keys → a key with "Sign in with Apple".
# APPLE_TEAM_ID (under "App links" below) is shared with the website.
APPLE_KEY_ID=
# The .p8 file's contents on one line, double quotes, \n for line breaks.
APPLE_PRIVATE_KEY=
# The app's bundle id, unless it differs.
APPLE_CLIENT_ID=za.co.onstage

# ── Admin CMS sign-in ────────────────────────────────────────────────────────
# [REQUIRED] One JSON entry per operator, made with
#   npm run hash-password -w @onstage/admin -- you@onstage.co.za [api-user-uuid]
# Keep the single quotes: the hashes contain $ signs.
ADMIN_USERS='CHANGE_ME'
# [REQUIRED] Signs CMS session cookies. openssl rand -hex 32
ADMIN_SESSION_SECRET=CHANGE_ME

# ── Public website & app links ───────────────────────────────────────────────
# [optional] Store listings shown on the website.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# [optional, needed for app links] Android signing-cert SHA-256 fingerprint(s),
# comma-separated (eas credentials / Play Console → App integrity).
ANDROID_CERT_SHA256=
# [optional, needed for app links] 10-character Apple Developer Team ID.
APPLE_TEAM_ID=
# [optional] Only if the app identifiers ever differ from za.co.onstage.
ANDROID_PACKAGE=za.co.onstage
IOS_BUNDLE_ID=za.co.onstage
# [optional, NOT YET WIRED] Media CDN host (e.g. cdn.onstage.co.za) to restrict
# website images to. Read only while building the Next apps, which the
# Dockerfile does not pass through yet (docs/DEPLOY.md, "Known gaps").
CDN_HOSTNAME=
# [optional] Base URL for uploaded media. Nothing uploads yet.
CDN_BASE_URL=

# ── Event ingestion (worker) ─────────────────────────────────────────────────
# Verify each provider's commercial terms before adding its key.
INGESTION_ENABLED=true
INGESTION_HOT_CRON=0 * * * *
INGESTION_COLD_CRON=0 4 * * *
NOTIFICATIONS_CRON=*/5 * * * *
WORKER_TIMEZONE=Africa/Johannesburg
INGESTION_MARKETS=ZA
JOB_MAX_RUNTIME_MS=7200000
LOG_LEVEL=info
# [optional] Provider credentials; a missing key just skips that provider.
QUICKET_API_KEY=
BANDSINTOWN_APP_ID=
SONGKICK_API_KEY=
TICKETMASTER_API_KEY=
# [optional] Howler pushes events to https://<API_DOMAIN>/v1/integrations/howler/events
# with this value in X-Howler-Webhook-Token. Setting it switches the feature on.
# If set, at least 32 characters: openssl rand -hex 32
HOWLER_WEBHOOK_TOKEN=
# [optional] Comma-separated Howler organiser ids to accept; empty accepts any.
HOWLER_ORGANISER_IDS=
# [optional] Contact URL/e-mail sent to MusicBrainz in the User-Agent.
MUSICBRAINZ_CONTACT=

# ── Account deletion (POPIA) ─────────────────────────────────────────────────
DELETION_GRACE_DAYS=7
ACCOUNT_DELETION_CRON=30 3 * * *

# ── Push notifications ───────────────────────────────────────────────────────
# expo = really send through Expo's push service. Anything else only logs them
# (the worker warns at startup unless this is expo).
PUSH_DELIVERY=expo
# [optional] Only once "enhanced push security" is enabled on the Expo project.
EXPO_ACCESS_TOKEN=

# ── Other integrations ───────────────────────────────────────────────────────
# [optional]
GOOGLE_MAPS_API_KEY=
UBER_CLIENT_ID=
# [optional] Affiliate attribution on outbound ticket links. Keep single quotes.
AFFILIATE_ID=
AFFILIATE_PARAMS='{"quicket":"ref","webtickets":"ref","ticketmaster":"camefrom","howler":"ref"}'

# ── POPIA ────────────────────────────────────────────────────────────────────
# Bump when the privacy policy changes; stored with every consent record.
PRIVACY_POLICY_VERSION=2026-01-01

# ── Error reporting (Sentry) ─────────────────────────────────────────────────
# [optional] Empty switches reporting off.
SENTRY_DSN=
# [optional, NOT YET WIRED] Browser-side Sentry for web/admin; build-time only,
# see docs/DEPLOY.md "Known gaps". Server-side errors use SENTRY_DSN above.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
