{
  "name": "@onstage/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Onstage mobile app — React Native via Expo, iOS and Android from one codebase.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "expo lint",
    "build": "eas build --profile production --platform all",
    "build:preview": "eas build --profile preview --platform android",
    "export:check": "expo export --platform android --platform ios --output-dir .expo-export"
  },
  "dependencies": {
    "@firebase/auth": "1.13.6",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@maplibre/maplibre-react-native": "11.5.0",
    "@onstage/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.59.20",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.16",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "firebase": "^12.19.0",
    "i18next": "^23.16.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^15.1.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
