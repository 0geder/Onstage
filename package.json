{
  "name": "onstage",
  "version": "0.1.0",
  "private": true,
  "description": "Onstage — discover where your favourite artists are playing, get tickets, get there and talk about it.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @onstage/api",
    "db:migrate": "npm run db:migrate -w @onstage/api",
    "db:seed": "npm run db:seed -w @onstage/api",
    "dev:api": "npm run dev -w @onstage/api",
    "dev:worker": "npm run dev -w @onstage/worker",
    "dev:admin": "npm run dev -w @onstage/admin",
    "dev:mobile": "npm run start -w @onstage/mobile"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
